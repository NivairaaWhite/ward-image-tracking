# Ward reads these on startup if present. Copy this file to `.env` and
# fill in what you need -- everything here is optional.

# Your SerpApi key (https://serpapi.com/), used for the reverse-image
# search that powers "Check for sightings." Without this set here (or
# entered later from the Settings panel in the app), Ward will run but
# every scan will return an error telling you to add a key.
SERPAPI_API_KEY=

# Overrides the auto-generated Flask secret key (instance/.secret_key).
# You don't need to set this for normal local use.
# SECRET_KEY=

# Overrides the default SQLite database location (instance/ward.db).
# You don't need to set this for normal local use.
# DATABASE_URL=

# Port Ward listens on (default 5000). If it's taken, desktop.py/start.*
# automatically pick a free one; `python app.py` just uses this value.
# WARD_PORT=5000

# Set to 1 to run Flask's debug mode (auto-reload + in-browser debugger).
# Only applies to `python app.py` -- the start scripts / desktop.py ignore it.
# Not safe to leave on if anyone besides you can reach this machine.
# FLASK_DEBUG=0
